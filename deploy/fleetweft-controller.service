[Unit]
Description=Fleetweft rollout controller
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5
[Service]
Type=simple
User=fleetweft
Group=fleetweft
ExecStart=/opt/fleetweft/venv/bin/python -I -m fleetweft.mvp serve --config /etc/fleetweft/controller.json
Restart=on-failure
RestartSec=1
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/fleetweft/controller
UMask=0077
[Install]
WantedBy=multi-user.target
